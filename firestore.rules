rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Validation Helpers
    function isValidTransaction(data) {
      return data.amount is number 
        && data.date is string 
        && data.category is string 
        && data.type in ['income', 'expense']
        && data.description is string;
    }

    function isValidBankAccount(data) {
      return data.name is string && data.name.size() <= 100
        && data.balance is number;
    }

    function isValidDebt(data) {
      return data.creditor is string && data.creditor.size() <= 200
        && data.totalAmount is number
        && data.remainingAmount is number
        && data.dueDate is string
        && data.status in ['pending', 'paid', 'overdue', 'on_hold'];
    }

    function isValidCard(data) {
      return data.name is string && data.name.size() <= 100
        && data.limit is number
        && data.closingDay is number
        && data.dueDay is number;
    }

    // User Data Scoping
    match /users/{userId} {
      match /transactions/{id} {
        allow read, write: if isOwner(userId);
      }
      match /bankAccounts/{id} {
        allow read, write: if isOwner(userId);
      }
      match /debts/{id} {
        allow read, write: if isOwner(userId);
      }
      match /cards/{id} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
